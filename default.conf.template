server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Cache static assets
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The service worker, its manifest and the app shell must be revalidated
    # on every load: a cached copy keeps installed apps on the previous build.
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    location = /manifest.webmanifest {
        # The image's mime.types has no entry for .webmanifest.
        types {
            application/manifest+json webmanifest;
        }
        add_header Cache-Control "no-cache";
    }

    # Also reached through the index directive and the SPA fallback below.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Proxy API requests to the backend
    location /api/ {
        proxy_pass http://${API_HOST};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
